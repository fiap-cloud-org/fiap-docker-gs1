# Copie para .env.prod e use senhas fortes: cp .env.prod.example .env.prod
COMPOSE_PROJECT_NAME=ecommerce_prod

MYSQL_ROOT_PASSWORD=gere-uma-senha-forte-root
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=app_user
MYSQL_PASSWORD=gere-uma-senha-forte-app

APP_PORT=8484

# Usuário do Docker Hub onde a imagem é publicada (troque pelo seu)
DOCKER_HUB_USER=seu-usuario
IMAGE_TAG=v1.0.1
